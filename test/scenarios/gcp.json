      ],
      "difficulty": "medium"
    },
    {
      "prompt": "What gcloud commands exist under the 'ai' group? Help me discover them.",
      "must_include": [
        "gcloud ai --help",
        "--help"
      ],
      "must_not_include": [
        "gcloud list ai",
        "gcloud ai commands"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "List the available Dataflow jobs in region us-central1.",
      "must_include": [
        "gcloud dataflow jobs list",
