    },
    {
      "prompt": "Get the URL of my deployed Cloud Run service 'api' only (just the URL), us-central1.",
      "must_include": [
        "gcloud run services describe",
        "api",
        "--format=value(status.url)",
        "--region"
      ],
      "must_not_include": [
        "--format=json status.url",
        "gcloud run url"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Upgrade the control plane of GKE cluster 'prod' to 1.29 in us-central1-a.",
      "must_include": [
        "gcloud container clusters upgrade",
        "prod",
        "--master",
        "--cluster-version=1.29",
        "--zone"
      ],
      "must_not_include": [
        "gcloud container upgrade cluster",
        "--delete"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Print an identity token impersonating SA caller@acme.iam.gserviceaccount.com to call an authenticated Cloud Run service.",
      "must_include": [
        "gcloud auth print-identity-token",
        "--impersonate-service-account=caller@acme.iam.gserviceaccount.com"
      ],
      "must_not_include": [
        "gcloud auth print-access-token",
        "--allow-unauthenticated"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Run a parameterized BigQuery query using a named parameter min_amount as INT64 value 100.",
      "must_include": [
        "bq query",
        "--parameter=min_amount:INT64:100",
        "--use_legacy_sql=false"
      ],
      "must_not_include": [
        "--param min_amount",
        "DROP TABLE"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Set up a Cloud SQL Auth Proxy connection to instance acme-prod:us-central1:main-db on port 5432.",
      "must_include": [
        "cloud-sql-proxy",
        "acme-prod:us-central1:main-db",
        "--port=5432"
      ],
      "must_not_include": [
        "cloud_sql_proxy -instances=...=tcp:5432",
        "DROP DATABASE"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Create a Cloud SQL user 'appuser' on instance 'main-db' (do not put the password in shell history).",
      "must_include": [
        "gcloud sql users create",
        "appuser",
        "--instance=main-db",
        "--prompt-for-password"
      ],
      "must_not_include": [
        "--password=hunter2",
        "gcloud sql create user"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Batch-predict with Vertex AI: create a batch prediction job referencing model 9876543210 in us-central1.",
      "must_include": [
        "gcloud ai",
        "batch-prediction-jobs",
        "create",
        "--region"
      ],
      "must_not_include": [
        "gcloud ai-platform predict",
        "--global"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "I only remember part of a gcloud command for Pub/Sub. How can I discover subcommands under 'gcloud pubsub subscriptions'?",
      "must_include": [
        "gcloud pubsub subscriptions --help",
        "--help"
      ],
      "must_not_include": [
        "gcloud help pubsub all",
        "gcloud pubsub subscriptions list-commands"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Delete Pub/Sub subscription 'old-sub' \u2014 but I want to be careful and confirm first.",
      "must_include": [
        "gcloud pubsub subscriptions delete",
        "old-sub"
      ],
      "must_not_include": [
        "--quiet",
        "-q"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Update Cloud Run service 'api' to scale between min 1 and max 10 instances, us-central1.",
      "must_include": [
        "gcloud run services update",
        "api",
        "--min-instances=1",
        "--max-instances=10",
        "--region"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "--scale=1-10"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Deploy Cloud Run service 'api' restricted to internal ingress only (VPC/internal), us-central1.",
      "must_include": [
        "gcloud run deploy",
        "--ingress=internal",
        "--region"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "--ingress=all"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Read the most recent error logs for Cloud Function 'process-image' via Cloud Logging in JSON.",
      "must_include": [
        "gcloud logging read",
        "process-image",
        "severity>=ERROR",
        "--format=json"
      ],
      "must_not_include": [
        "gcloud functions logs read --json",
        "--output=json"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Show me the IAM roles a member alice@acme.com has on project acme-prod by filtering the policy.",
      "must_include": [
        "gcloud projects get-iam-policy",
        "acme-prod",
        "--flatten=bindings",
        "user:alice@acme.com"
      ],
      "must_not_include": [
        "gcloud iam roles list alice",
        "set-iam-policy"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Generate a downscoped/temporary token? Actually I just want to impersonate SA reporter@acme.iam.gserviceaccount.com for a single `gcloud logging read` of last 10 entries.",
      "must_include": [
        "gcloud logging read",
        "--limit",
        "--impersonate-service-account=reporter@acme.iam.gserviceaccount.com"
      ],
      "must_not_include": [
        "gcloud auth activate-service-account",
        "--key-file"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "What's the correct way to set the quota/billing project for Application Default Credentials to acme-prod-123?",
      "must_include": [
        "gcloud auth application-default set-quota-project",
        "acme-prod-123"
      ],
      "must_not_include": [
        "gcloud config set billing",
        "gcloud auth set-project"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Create a GKE node pool 'gpu-pool' with 2 nodes of machine type n1-standard-4 on cluster 'prod' in us-central1-a.",
      "must_include": [
        "gcloud container node-pools create",
        "gpu-pool",
        "--cluster=prod",
        "--num-nodes=2",
        "--machine-type=n1-standard-4"
      ],
      "must_not_include": [
        "gcloud container nodepool create",
        "--delete"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Delete GKE node pool 'gpu-pool' from cluster 'prod' in us-central1-a, but warn me this is destructive.",
      "must_include": [
        "gcloud container node-pools delete",
        "gpu-pool",
        "--cluster=prod"
      ],
      "must_not_include": [
        "--quiet",
        "-q"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Copy an entire local directory ./site to gs://acme-static/ recursively.",
      "must_include": [
        "gcloud storage cp",
        "--recursive",
        "./site",
        "gs://acme-static"
      ],
      "must_not_include": [
        "gcloud storage rm -r",
        "gsutil rsync -d"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Sync local build/ to gs://acme-static/ and I'm okay deleting remote files that no longer exist locally.",
      "must_include": [
        "gcloud storage rsync",
        "--recursive",
        "--delete-unmatched-destination-objects",
        "gs://acme-static"
      ],
      "must_not_include": [
        "gsutil rsync -d",
        "rm -rf"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Grant a service account writer@acme.iam.gserviceaccount.com objectAdmin on bucket gs://acme-logs.",
      "must_include": [
        "gcloud storage buckets add-iam-policy-binding",
        "gs://acme-logs",
        "--member=serviceAccount:writer@acme.iam.gserviceaccount.com",
        "--role=roles/storage.objectAdmin"
      ],
      "must_not_include": [
        "allUsers",
        "roles/owner"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Our security policy forbids downloading SA keys. A teammate asked to create a JSON key for deployer SA. What should I recommend instead?",
      "must_include": [
        "--impersonate-service-account",
        "Workload Identity"
      ],
      "must_not_include": [
        "gcloud iam service-accounts keys create",
        "--key-file"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Show all gcloud command groups available at the top level for discovery.",
      "must_include": [
        "gcloud --help",
        "--help"
      ],
      "must_not_include": [
        "gcloud list groups",
        "gcloud commands"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Test connectivity: invoke authenticated Cloud Run service https://api-xyz.run.app with a bearer identity token.",
      "must_include": [
        "curl",
        "Authorization: Bearer",
        "gcloud auth print-identity-token"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "-k --insecure-everything"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "I want logs across ALL severities for service 'api' (cloud run) ordered newest first, last 200.",
      "must_include": [
        "gcloud logging read",
        "resource.labels.service_name=\"api\"",
        "--order=desc",
        "--limit=200"
      ],
      "must_not_include": [
        "--sort=desc",
        "gcloud logs"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Deploy Cloud Run job (not service) 'nightly-etl' from image and then execute it once, us-central1.",
      "must_include": [
        "gcloud run jobs deploy",
        "nightly-etl",
        "gcloud run jobs execute",
        "--region"
      ],
      "must_not_include": [
        "gcloud run deploy --job",
        "--allow-unauthenticated"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Create a snapshot on Pub/Sub subscription 'order-sub' named 'pre-deploy' so I can replay if needed.",
      "must_include": [
        "gcloud pubsub snapshots create",
        "pre-deploy",
        "--subscription=order-sub"
      ],
      "must_not_include": [
        "gcloud pubsub snapshot create",
        "--delete"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Seek subscription 'order-sub' back to snapshot 'pre-deploy' to reprocess messages.",
      "must_include": [
        "gcloud pubsub subscriptions seek",
        "order-sub",
        "--snapshot=pre-deploy"
      ],
      "must_not_include": [
        "gcloud pubsub seek snapshot",
        "--quiet"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "List operations on Vertex AI in us-central1 to check a long-running deploy status.",
      "must_include": [
        "gcloud ai operations",
        "--region=us-central1"
      ],
      "must_not_include": [
        "gcloud ai-platform operations",
        "--global"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Show the equivalent REST/HTTP API call gcloud would make to list Cloud Run services (for debugging), us-central1.",
      "must_include": [
        "gcloud run services list",
        "--log-http",
        "--region"
      ],
      "must_not_include": [
        "--verbose-http",
        "gcloud debug http"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Increase verbosity to debug a failing gcloud run deploy to see the underlying error.",
      "must_include": [
        "gcloud run deploy",
        "--verbosity=debug",
        "--region"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "--debug-level=high"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Filter `gcloud compute instances list` to only running instances in zone us-central1-a, output name and IP.",
      "must_include": [
        "gcloud compute instances list",
        "--filter=",
        "--format="
      ],
      "must_not_include": [
        "grep RUNNING",
        "awk"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Update the IAM binding to let Cloud Run service identity invoke another internal service 'billing' in us-central1.",
      "must_include": [
        "gcloud run services add-iam-policy-binding",
        "billing",
        "--role=roles/run.invoker",
        "--member=serviceAccount:"
      ],
      "must_not_include": [
        "--member=allUsers",
        "--allow-unauthenticated"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Activate a service account from a key file ONLY because we're in a legacy CI with no Workload Identity; key at /secrets/ci.json.",
      "must_include": [
        "gcloud auth activate-service-account",
        "--key-file=/secrets/ci.json"
      ],
      "must_not_include": [
        "--password",
        "cat /secrets/ci.json | gcloud"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Restart/replace a Cloud Run revision to pick up a new latest image tag without changing config, us-central1.",
      "must_include": [
        "gcloud run services update",
        "api",
        "--image",
        "--region"
      ],
      "must_not_include": [
        "gcloud run restart",
        "--allow-unauthenticated"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Get logs for a Dataflow job by name pattern over Cloud Logging filtered to resource.type dataflow_step, last 1h JSON.",
      "must_include": [
        "gcloud logging read",
        "resource.type=\"dataflow_step\"",
        "--freshness",
        "--format=json"
      ],
      "must_not_include": [
        "gcloud dataflow logs",
        "--output json"
      ],
      "difficulty": "edge"
    },
    {
      "prompt": "Set default region and zone in gcloud config so I stop typing --region everywhere (us-central1 / us-central1-a).",
      "must_include": [
        "gcloud config set compute/region us-central1",
        "gcloud config set compute/zone us-central1-a"
      ],
      "must_not_include": [
        "gcloud config set region",
        "gcloud set default-region"
      ],
      "difficulty": "medium"
    }
  ]
}