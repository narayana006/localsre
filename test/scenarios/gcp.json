      ],
      "must_not_include": [
        "roles/owner",
        "--allow-unauthenticated"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Allow service account a@acme.iam.gserviceaccount.com to impersonate b@acme.iam.gserviceaccount.com. What binding is needed?",
      "must_include": [
        "gcloud iam service-accounts add-iam-policy-binding",
