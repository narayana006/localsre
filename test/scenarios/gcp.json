      ],
      "must_not_include": [
        "bq import",
        "--format=json"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Export Cloud SQL instance 'main-db' database 'app' to gs://acme-backups/app.sql.gz as a SQL dump.",
