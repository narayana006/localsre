      "prompt": "Create a HTTP-triggered scheduler-like Pub/Sub push subscription 'push-sub' on topic 'jobs' delivering to https://api.acme.com/hook with OIDC auth SA invoker@acme.iam.gserviceaccount.com.",
      "must_include": [
