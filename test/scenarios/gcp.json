      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "--ram=512"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "GKE pods can't pull images with ImagePullBackOff. After getting credentials, what's the first kubectl command to inspect a failing pod 'web-abc' in namespace 'prod'?",
      "must_include": [
        "gcloud container clusters get-credentials",
