      ],
      "must_not_include": [
        "gcloud container clusters create-autopilot",
        "--zone"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Resize the default node pool of standard GKE cluster 'prod' to 5 nodes in us-central1-a.",
      "must_include": [
        "gcloud container clusters resize",
