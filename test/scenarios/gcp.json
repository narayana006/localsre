      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "allUsers"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Roll back Cloud Run service 'api' to route 100% traffic to revision api-00007-abc in us-central1.",
      "must_include": [
        "gcloud run services update-traffic",
        "--to-revisions=api-00007-abc=100",
        "--region"
      ],
      "must_not_include": [
        "gcloud run rollback",
        "--to-latest=true"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Split Cloud Run traffic 90/10 between revisions api-00007 and api-00008 for a canary in us-central1.",
      "must_include": [
        "gcloud run services update-traffic",
        "--to-revisions=",
        "api-00007=90",
        "api-00008=10"
      ],
      "must_not_include": [
        "--to-latest",
        "--allow-unauthenticated"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Create a GKE Autopilot cluster 'ap-prod' in region us-central1.",
      "must_include": [
        "gcloud container clusters create-auto",
        "ap-prod",
