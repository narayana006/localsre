      "must_not_include": [
        "gcloud pubsub push create",
        "--no-auth"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Set IAM policy so Cloud Run service 'api' is invokable by allUsers (genuinely public marketing site), us-central1. Note this is intended public.",
      "must_include": [
        "gcloud run services add-iam-policy-binding",
