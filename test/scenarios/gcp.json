      ],
      "must_not_include": [
        "gcloud dataproc submit job",
        "--allow-unauthenticated"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Deploy Cloud Run service 'api' and limit memory to 512Mi and CPU to 1, region us-central1.",
      "must_include": [
        "gcloud run deploy",
