      ],
      "must_not_include": [
        "roles/run.admin",
        "--allow-unauthenticated"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "I have a JSON key file for an SA but want to avoid downloading keys. How do I authenticate as the SA without a key for a one-off bq query?",
      "must_include": [
        "bq query",
        "--impersonate-service-account=",
        "--use_legacy_sql=false"
      ],
      "must_not_include": [
        "gcloud auth activate-service-account --key-file",
