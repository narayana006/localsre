      "must_not_include": [
        "gcloud ai-platform deploy",
        "--global"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Upload a model to Vertex AI Model Registry named 'classifier' with a container image and artifacts in gs://acme-models/v1, region us-central1.",
