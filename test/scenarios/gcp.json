{
  "skill": "gcp",
  "scenarios": [
    {
      "prompt": "Deploy my container image us-docker.pkg.dev/acme/web/api:v3 to Cloud Run service 'api' in us-central1.",
      "must_include": [
        "gcloud run deploy",
        "--image",
        "--region"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "gcloud cloudrun deploy"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "How do I get kubectl credentials for my GKE cluster 'prod-cluster' in zone us-central1-a?",
      "must_include": [
        "gcloud container clusters get-credentials",
        "prod-cluster",
        "--zone"
      ],
      "must_not_include": [
        "kubectl get-credentials",
        "gcloud gke credentials"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Read the last 50 log entries for my Cloud Run service named 'checkout'.",
      "must_include": [
        "gcloud logging read",
        "checkout",
        "--limit"
      ],
      "must_not_include": [
        "gcloud logs read",
        "gcloud logging tail --forever"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Describe the Cloud Run service 'payments' in europe-west1.",
      "must_include": [
        "gcloud run services describe",
        "payments",
        "--region"
      ],
      "must_not_include": [
        "gcloud run describe payments",
        "--global"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "List all my Pub/Sub topics in the current project.",
      "must_include": [
        "gcloud pubsub topics list",
        "list"
      ],
      "must_not_include": [
        "gcloud pubsub list topics",
        "gcloud pub-sub"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Create a Pub/Sub topic called 'order-events'.",
      "must_include": [
        "gcloud pubsub topics create",
        "order-events"
      ],
      "must_not_include": [
        "gcloud pubsub create topic",
        "--delete"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Run a BigQuery query to count rows in dataset analytics table events.",
      "must_include": [
        "bq query",
        "--use_legacy_sql=false",
        "count"
      ],
      "must_not_include": [
        "bq run query",
        "DROP TABLE"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "I need to authenticate gcloud with my Google account interactively.",
      "must_include": [
        "gcloud auth login",
        "auth login"
      ],
      "must_not_include": [
        "gcloud login auth",
        "gcloud auth signin"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Set up Application Default Credentials so my local code can call Google APIs.",
      "must_include": [
        "gcloud auth application-default login",
        "application-default"
      ],
      "must_not_include": [
        "gcloud auth adc login",
        "export GOOGLE_APPLICATION_CREDENTIALS=password"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "List my Cloud SQL instances.",
      "must_include": [
        "gcloud sql instances list",
        "instances list"
      ],
      "must_not_include": [
        "gcloud sql list instances",
        "gcloud cloudsql instances"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "List the IAM service accounts in my project.",
      "must_include": [
        "gcloud iam service-accounts list",
        "service-accounts"
      ],
      "must_not_include": [
        "gcloud iam list service-accounts",
        "gcloud service-accounts list"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Which gcloud account am I currently logged in as?",
      "must_include": [
        "gcloud auth list",
        "auth list"
      ],
      "must_not_include": [
        "gcloud whoami",
        "gcloud account show"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Set my active gcloud project to acme-prod-123.",
      "must_include": [
        "gcloud config set project",
        "acme-prod-123"
      ],
      "must_not_include": [
        "gcloud project set",
        "gcloud set project"
      ],
      "difficulty": "easy"
    },
    {
      "prompt": "Deploy a 2nd gen Cloud Function 'process-image' triggered by HTTP from source ./fn in us-central1, Python 3.12.",
      "must_include": [
        "gcloud functions deploy",
        "--gen2",
        "--runtime=python312",
        "--trigger-http"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "gcloud function deploy"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Pull one message from Pub/Sub subscription 'order-sub' and acknowledge it.",
      "must_include": [
        "gcloud pubsub subscriptions pull",
        "order-sub",
        "--auto-ack"
      ],
      "must_not_include": [
        "gcloud pubsub pull subscription",
        "topics pull"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Create a Pub/Sub subscription 'order-sub' on topic 'order-events' with a 60 second ack deadline.",
      "must_include": [
        "gcloud pubsub subscriptions create",
        "order-sub",
        "--topic",
        "--ack-deadline"
      ],
      "must_not_include": [
        "gcloud pubsub create subscription",
        "--ack-timeout"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Tail logs in real time for GKE workload in namespace 'web' filtering severity ERROR.",
      "must_include": [
        "gcloud logging tail",
        "severity",
        "ERROR"
      ],
      "must_not_include": [
        "gcloud logging read --follow",
        "kubectl logs --severity"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Read logs from the last hour for Cloud Function 'process-image' in us-central1.",
      "must_include": [
        "gcloud logging read",
        "process-image",
        "--freshness"
      ],
      "must_not_include": [
        "gcloud functions logs read --hours",
        "--since=1h"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Read logs only for resource type cloud_run_revision and service 'api', most recent 100, in JSON.",
      "must_include": [
        "gcloud logging read",
        "resource.type=",
        "cloud_run_revision",
        "--format=json"
      ],
      "must_not_include": [
        "--output=json",
        "gcloud logs"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Grant roles/run.invoker on Cloud Run service 'api' to service account svc@acme.iam.gserviceaccount.com in us-central1.",
      "must_include": [
        "gcloud run services add-iam-policy-binding",
        "--member=serviceAccount:",
        "--role=roles/run.invoker"
      ],
      "must_not_include": [
        "allUsers",
        "--allow-unauthenticated"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Grant roles/storage.objectViewer on the project to user alice@acme.com.",
      "must_include": [
        "gcloud projects add-iam-policy-binding",
        "--member=user:",
        "--role=roles/storage.objectViewer"
      ],
      "must_not_include": [
        "roles/owner",
        "gcloud iam grant"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Create a service account named 'deployer' with display name 'CI Deployer'.",
      "must_include": [
        "gcloud iam service-accounts create",
        "deployer",
        "--display-name"
      ],
      "must_not_include": [
        "gcloud iam create service-account",
        "--password"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "I want to run gcloud commands impersonating the deploy service account deployer@acme.iam.gserviceaccount.com when listing buckets.",
      "must_include": [
        "gcloud storage buckets list",
        "--impersonate-service-account=deployer@acme.iam.gserviceaccount.com"
      ],
      "must_not_include": [
        "--key-file",
        "gcloud auth activate-service-account"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Set up Application Default Credentials but impersonating service account pipeline@acme.iam.gserviceaccount.com.",
      "must_include": [
        "gcloud auth application-default login",
        "--impersonate-service-account=pipeline@acme.iam.gserviceaccount.com"
      ],
      "must_not_include": [
        "--key-file",
        "GOOGLE_APPLICATION_CREDENTIALS"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Deploy Cloud Run service 'api' from source in current dir, set env var LOG_LEVEL=debug, region us-central1.",
      "must_include": [
        "gcloud run deploy",
        "--source",
        "--set-env-vars",
        "--region"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "--env LOG_LEVEL"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Update Cloud Run service 'api' to use service account runtime@acme.iam.gserviceaccount.com.",
      "must_include": [
        "gcloud run services update",
        "api",
        "--service-account",
        "--region"
      ],
      "must_not_include": [
        "--allow-unauthenticated",
        "gcloud run update api --sa"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Show the schema of BigQuery table acme-prod:analytics.events.",
      "must_include": [
        "bq show",
        "analytics.events",
        "--schema"
      ],
      "must_not_include": [
        "bq describe",
        "ALTER TABLE"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Estimate the bytes a query will scan over analytics.events without actually running it.",
      "must_include": [
        "bq query",
        "--dry_run",
        "--use_legacy_sql=false"
      ],
      "must_not_include": [
        "--estimate",
        "bq dry-run"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Connect to my Cloud SQL Postgres instance 'main-db' using the gcloud sql client.",
      "must_include": [
        "gcloud sql connect",
        "main-db",
        "--user"
      ],
      "must_not_include": [
        "gcloud sql login",
        "DROP DATABASE"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "List Vertex AI models in region us-central1.",
      "must_include": [
        "gcloud ai models list",
        "--region"
      ],
      "must_not_include": [
        "gcloud vertex models list",
        "gcloud ai-platform models"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "Show me how to list custom training jobs in Vertex AI for region europe-west4.",
      "must_include": [
        "gcloud ai custom-jobs list",
        "--region=europe-west4"
      ],
      "must_not_include": [
        "gcloud ai-platform jobs list",
        "gcloud ml jobs"
      ],
      "difficulty": "medium"
    },
    {
      "prompt": "I forgot the exact flags for deploying to Cloud Run. How can I see all available options?",
      "must_include": [
        "gcloud run deploy --help",
