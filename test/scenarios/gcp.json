      ],
      "must_not_include": [
        "bq insert",
        "DROP TABLE daily_agg"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Load a newline-delimited JSON file gs://acme/data/events.json into BigQuery table analytics.events with autodetect schema.",
      "must_include": [
        "bq load",
        "--source_format=NEWLINE_DELIMITED_JSON",
