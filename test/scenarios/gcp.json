      ],
      "must_not_include": [
        "roles/owner",
        "roles/iam.serviceAccountAdmin"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Deploy Cloud Run 'internal-api' that must NOT be publicly reachable (require auth) in us-central1.",
      "must_include": [
        "gcloud run deploy",
        "--no-allow-unauthenticated",
