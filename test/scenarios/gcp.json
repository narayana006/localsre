        "pod_name"
      ],
      "must_not_include": [
        "gcloud logs read pod",
        "kubectl logs --since-time"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "My Cloud Run deploy is failing with permission denied pushing to Artifact Registry. What IAM role does the Cloud Build / deploy SA need and how do I grant it?",
      "must_include": [
        "roles/artifactregistry.writer",
