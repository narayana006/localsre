      ],
      "must_not_include": [
        "kubectl delete pod",
        "--force --grace-period=0"
      ],
      "difficulty": "hard"
    },
    {
      "prompt": "Read logs for a specific GKE pod by name 'web-abc' in cluster project acme-prod for the last 30 minutes via Cloud Logging.",
      "must_include": [
        "gcloud logging read",
        "resource.type=",
